+// FindOCIRuntime returns the first regular OCI runtime from the configured paths.
+// PATH is used only when no exclusive packaged executable directory is configured.
+func FindOCIRuntime(name string, paths []string) (string, error) {
+	if dir := PackagedExecutableDir(); dir != "" {
+		binary := name
+		if len(paths) > 0 {
+			binary = paths[0]
+		}
+		paths = []string{filepath.Join(dir, filepath.Base(binary))}
+	}
+
+	for _, path := range paths {
+		stat, err := os.Stat(path)
+		if err != nil {
+			if errors.Is(err, os.ErrNotExist) {
+				continue
+			}
+			return "", err
+		}
+		if !stat.Mode().IsRegular() {
+			continue
+		}
+		logrus.Tracef("found runtime %q", path)
+		return path, nil
+	}
+
+	if PackagedExecutableDir() == "" {
+		if path, err := exec.LookPath(name); err == nil {
+			logrus.Debugf("using runtime %q from $PATH: %q", name, path)
+			return path, nil
+		}
+	}
+
+	return "", nil
+}
