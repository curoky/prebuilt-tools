+// PackagedExecutableDir returns the exclusive executable directory set by the packager.
+func PackagedExecutableDir() string {
+	if additionalHelperBinariesDir == "" {
+		return ""
+	}
+	bindir := findBindir()
+	if bindir == "" {
+		return additionalHelperBinariesDir
+	}
+	return filepath.Clean(strings.Replace(additionalHelperBinariesDir, bindirPrefix, bindir, 1))
+}
