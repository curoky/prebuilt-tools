[Unit]
Description=Podman API Service
After=network.target

[Service]
Type=simple
User=root
# Environment=PATH=@PODMANX_ROOT@/bin:/usr/local/bin:/usr/bin:/bin
ExecStart="@PODMANX_ROOT@/bin/podman-server"
ExecStartPost=/bin/sh -c 'for i in $(seq 1 50); do [ -S /run/podman/podman.sock ] && { chmod 0777 /run/podman/podman.sock; exit 0; }; sleep 0.1; done'
ExecStop="@PODMANX_ROOT@/bin/podman" stop --all
Restart=always
RestartSec=30s

[Install]
WantedBy=multi-user.target
